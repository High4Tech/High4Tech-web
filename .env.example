PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URL=file:./studio.db
# Vercel: use a remote libsql:// database instead of file:./studio.db.
# Add these values privately in the Vercel project, never in Git.
# DATABASE_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# Canonical public origin on deployment, e.g. https://high4tech.example
# SITE_URL=
# Optional: only set if a trusted hosting proxy overwrites this IP header.
# Never trust a raw visitor-supplied X-Forwarded-For header.
# TRUSTED_CLIENT_IP_HEADER=
