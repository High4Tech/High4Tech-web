{
  "name": "high4tech-frontend-draft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:vercel": "node --import tsx scripts/vercel-build.ts",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "cms:types": "payload generate:types",
    "cms:setup": "node scripts/setup-cms.mjs",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate": "payload migrate",
    "cms:verify": "node --env-file=.env --import tsx scripts/verify-cms.ts",
    "deployment:verify": "node --import tsx scripts/verify-deployment.ts",
    "assistant:verify": "node --import tsx scripts/verify-assistant.ts",
    "assistant:verify:cms": "node --env-file=.env --import tsx scripts/verify-assistant-cms.ts"
  },
  "dependencies": {
    "@fontsource/unbounded": "^5.2.0",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@react-three/fiber": "^9.0.0",
    "graphql": "16.13.2",
    "gsap": "^3.14.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "payload": "3.90.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "three": "^0.180.0"
  },
  "overrides": {
    "sass": "1.105.1",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
